<Project Sdk="Microsoft.NET.Sdk.Web">
    
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>exchange_simulator.Server</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
      <UserSecretsId>294fba4a-c8df-4cbd-9338-6162b36d5912</UserSecretsId>
  </PropertyGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\exchange-simulator\exchange-simulator.csproj" />
        <ProjectReference Include="..\exchange-simulator.Contracts\exchange-simulator.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="exchange-simulator.Tests" />
    </ItemGroup>
    
</Project>